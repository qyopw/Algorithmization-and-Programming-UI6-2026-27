{
  "configurations": [
    {
      "name": "macos-clang-x64",
      "includePath": [
        "${workspaceFolder}/**"
      ],
      "compilerPath": "/usr/bin/clang",
      "cppStandard": "${default}",
      "intelliSenseMode": "macos-clang-x64",
      "cStandard": "${default}"
    },
    {
      "name": "Windows (MinGW g++)",
      "includePath": [
        "${workspaceFolder}/**"
      ],
      "compilerPath": "g++",
      "cppStandard": "c++17",
      "intelliSenseMode": "windows-gcc-x64"
    },
    {
      "name": "Linux (g++)",
      "includePath": [
        "${workspaceFolder}/**"
      ],
      "compilerPath": "g++",
      "cppStandard": "c++17",
      "intelliSenseMode": "linux-gcc-x64"
    }
  ],
  "version": 4
}